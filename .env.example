# Copy as .env and change before docker compose up --build
# Use a URL-safe, strong password or percent-encode reserved characters in connection URIs.
POSTGRES_PASSWORD=replace-with-strong-url-safe-secret
# Only add trusted web frontend origins, comma-separated; leave empty for no CORS access.
NOR_CORS_ORIGINS=
# Local Python API (default) uses SQLite; PostgreSQL example below:
# NOR_DATABASE_URL=postgresql+psycopg://norid:secret@localhost:5432/norid

# Nama baru yang diutamakan oleh API v0.3 (opsional)
# RPI_DATABASE_URL=sqlite+pysqlite:////jalur/pekerjaan-indonesia.sqlite3
